{
  "name": "@navios/otel",
  "version": "2.0.0-alpha.0",
  "description": "OpenTelemetry integration for Navios framework",
  "license": "MIT",
  "author": {
    "name": "Oleksandr Hanzha",
    "email": "alex@granted.name"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navios-org/navios.git",
    "directory": "packages/otel"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "typings": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./legacy-compat": {
      "import": {
        "types": "./lib/legacy-compat/index.d.mts",
        "default": "./lib/legacy-compat/index.mjs"
      },
      "require": {
        "types": "./lib/legacy-compat/index.d.cts",
        "default": "./lib/legacy-compat/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./lib/http/index.d.mts",
        "default": "./lib/http/index.mjs"
      },
      "require": {
        "types": "./lib/http/index.d.cts",
        "default": "./lib/http/index.cjs"
      }
    }
  },
  "scripts": {
    "check": "tsc -b tsconfig.json tsconfig.e2e.json",
    "lint": "yarn run -T oxlint --fix && yarn run -T oxfmt",
    "test:ci": "vitest run && bun test e2e/bun",
    "build": "tsdown",
    "publish": "node ../../scripts/assert-stable-version.mjs && yarn npm publish --access public",
    "publish:next": "yarn npm publish --access public --tag next"
  },
  "dependencies": {
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0"
  },
  "devDependencies": {
    "@navios/adapter-bun": "workspace:^",
    "@navios/adapter-fastify": "workspace:^",
    "@navios/builder": "workspace:^",
    "@navios/core": "workspace:^",
    "@navios/server": "workspace:^",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@navios/core": "workspace:*",
    "@navios/server": "workspace:*",
    "@opentelemetry/api": ">=1.10.0 <1.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": ">=0.300.0 <0.400.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.300.0 <0.400.0"
  },
  "peerDependenciesMeta": {
    "@navios/server": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
