{
  "name": "@navios/di",
  "version": "2.0.0-alpha.0",
  "license": "MIT",
  "author": {
    "name": "Oleksandr Hanzha",
    "email": "alex@granted.name"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navios-org/navios.git",
    "directory": "packages/di"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/symbol-metadata.mts",
    "./src/index.mts",
    "./src/internal/index.mts",
    "./src/testing/index.mts",
    "./src/legacy-compat/index.mts",
    "./lib/symbol-metadata-*",
    "./lib/index.*",
    "./lib/internal/index.*",
    "./lib/testing/index.*",
    "./lib/legacy-compat/index.*"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "typings": "./lib/index.d.mts",
  "exports": {
    ".": {
      "bun": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "deno": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "node": {
        "import": {
          "types": "./lib/index.d.mts",
          "default": "./lib/index.mjs"
        },
        "require": {
          "types": "./lib/index.d.cts",
          "default": "./lib/index.cjs"
        }
      },
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./lib/internal/index.d.mts",
        "default": "./lib/internal/index.mjs"
      },
      "require": {
        "types": "./lib/internal/index.d.cts",
        "default": "./lib/internal/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./lib/testing/index.d.mts",
        "default": "./lib/testing/index.mjs"
      },
      "require": {
        "types": "./lib/testing/index.d.cts",
        "default": "./lib/testing/index.cjs"
      }
    },
    "./legacy-compat": {
      "import": {
        "types": "./lib/legacy-compat/index.d.mts",
        "default": "./lib/legacy-compat/index.mjs"
      },
      "require": {
        "types": "./lib/legacy-compat/index.d.cts",
        "default": "./lib/legacy-compat/index.cjs"
      }
    }
  },
  "scripts": {
    "check": "tsc -b",
    "lint": "yarn run -T oxlint --fix && yarn run -T oxfmt",
    "test:ci": "vitest run",
    "build": "tsdown",
    "publish": "node ../../scripts/assert-stable-version.mjs && yarn npm publish --access public",
    "publish:next": "yarn npm publish --access public --tag next",
    "bench": "NODE_ENV=production node benchmarks/di.bench.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "rolldown": "~1.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
