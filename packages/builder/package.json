{
  "name": "@navios/builder",
  "version": "2.0.0-alpha.0",
  "license": "MIT",
  "author": {
    "name": "Oleksandr Hanzha",
    "email": "alex@granted.name"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navios-org/navios.git",
    "directory": "packages/builder"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "typings": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./socket": {
      "import": {
        "types": "./lib/socket.d.mts",
        "default": "./lib/socket.mjs"
      },
      "require": {
        "types": "./lib/socket.d.cts",
        "default": "./lib/socket.cjs"
      }
    },
    "./mock": {
      "import": {
        "types": "./lib/mock.d.mts",
        "default": "./lib/mock.mjs"
      },
      "require": {
        "types": "./lib/mock.d.cts",
        "default": "./lib/mock.cjs"
      }
    },
    "./eventsource": {
      "import": {
        "types": "./lib/eventsource.d.mts",
        "default": "./lib/eventsource.mjs"
      },
      "require": {
        "types": "./lib/eventsource.d.cts",
        "default": "./lib/eventsource.cjs"
      }
    }
  },
  "scripts": {
    "check": "tsc -b",
    "lint": "yarn run -T oxlint --fix && yarn run -T oxfmt",
    "test:ci": "vitest run",
    "build": "tsdown",
    "publish": "node ../../scripts/assert-stable-version.mjs && yarn npm publish --access public",
    "publish:next": "yarn npm publish --access public --tag next"
  },
  "devDependencies": {
    "@navios/http": "workspace:^",
    "arktype": "^2.2.10",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  }
}
