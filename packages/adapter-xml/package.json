{
  "name": "@navios/adapter-xml",
  "version": "2.0.0-alpha.0",
  "license": "MIT",
  "author": {
    "name": "Oleksandr Hanzha",
    "email": "alex@granted.name"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navios-org/navios.git",
    "directory": "packages/adapter-xml"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "typings": "./lib/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./lib/jsx-runtime.d.mts",
        "default": "./lib/jsx-runtime.mjs"
      },
      "require": {
        "types": "./lib/jsx-runtime.d.cts",
        "default": "./lib/jsx-runtime.cjs"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./lib/jsx-dev-runtime.d.mts",
        "default": "./lib/jsx-dev-runtime.mjs"
      },
      "require": {
        "types": "./lib/jsx-dev-runtime.d.cts",
        "default": "./lib/jsx-dev-runtime.cjs"
      }
    },
    "./jsx": {
      "import": {
        "types": "./jsx.d.ts",
        "default": "./lib/jsx.mjs"
      },
      "require": {
        "types": "./jsx.d.ts",
        "default": "./lib/jsx.cjs"
      }
    }
  },
  "scripts": {
    "check": "tsc -b",
    "lint": "yarn run -T oxlint --fix && yarn run -T oxfmt",
    "test:ci": "vitest run && vitest run -c vitest.e2e.config.mts && bun test e2e/bun",
    "build": "tsdown",
    "publish": "node ../../scripts/assert-stable-version.mjs && yarn npm publish --access public",
    "publish:next": "yarn npm publish --access public --tag next"
  },
  "devDependencies": {
    "@navios/adapter-bun": "workspace:^",
    "@navios/adapter-fastify": "workspace:^",
    "@navios/builder": "workspace:^",
    "@navios/core": "workspace:^",
    "@navios/server": "workspace:^",
    "@types/bun": "^1.4.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@navios/core": "workspace:*",
    "@navios/server": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.10"
  }
}
