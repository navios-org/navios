{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["rspress.config.ts", "content/**/*.tsx", "theme", "scripts", "env.d.ts"],
  "exclude": ["build", "node_modules"]
}
