# =============================================================================
# Development Configuration
# =============================================================================
# Optimized for local development with Docker Compose stack.
# Use: docker-compose up -d && cp .env.development .env && yarn start

OTEL_SERVICE_NAME=otel-fastify-example
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development

# Send to Jaeger directly (simpler setup)
OTEL_EXPORTER=otlp
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Full instrumentation for debugging
OTEL_AUTO_INSTRUMENT_HTTP=true
OTEL_INCLUDE_NAVIOS_ATTRIBUTES=true

# Enable metrics
OTEL_METRICS_ENABLED=true

# Sample everything in development
OTEL_SAMPLING_RATIO=1.0

# Ignore health checks
OTEL_IGNORE_ROUTES=/health

PORT=3000
HOST=localhost
