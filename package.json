{
  "name": "@navios/mono",
  "packageManager": "yarn@4.19.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "lab-packages/*",
    "examples/*"
  ],
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "check:dts": "turbo run check:dts --filter=@navios/dts-check",
    "check:pack": "node scripts/check-exports-packed.mjs",
    "check:size": "turbo run check:size --filter=@navios/size-check",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "lint": "turbo run lint",
    "publish:all": "turbo run publish --filter='./packages/*'",
    "publish:next": "turbo run publish:next --filter='./packages/*' --filter=!@navios/cli --filter=!@navios/queues --filter=!@navios/microservice"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@swc/core": "^1.16.22",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "5.1.1",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.95.0",
    "tsdown": "^0.23.7",
    "tslib": "^2.9.1",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
